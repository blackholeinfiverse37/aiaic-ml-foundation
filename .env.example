# AIAIC ML Foundation - local settings. Copy to .env for local runs; .env is never committed.

# Where the served forecast bundle is (forecast_*.json, .joblib, _history.csv.gz). The Docker image sets its own.
AIAIC_MODELS_DIR=models/release

AIAIC_LOG_LEVEL=INFO

# Optional. Only the Test 1 training pipeline mirrors run logs to MongoDB; the forecast service never uses it.
# AIAIC_MONGO_URI=mongodb://localhost:27017

# To check an AIAIC server, give its address when you run the check. Never write a server or tunnel address here:
# this file is public.
#   AIAIC_API_BASE=http://<host>:<port> python scripts/check_aiaic_backend.py
