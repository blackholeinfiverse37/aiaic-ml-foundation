# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.eggs/
*.egg-info/
.eggs-info/

# --- Virtual environments ---
venv/
env/
.venv/
ENV/

# --- Environment / secrets ---
.env
.env.*
!.env.example

# --- Data (large / generated, not source) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/versions/*
!data/versions/.gitkeep

# --- Models (generated artifacts, not source) ---
models/*
!models/.gitkeep

# --- Logs ---
*.log
logs/
runtime_logs/*.log

# --- Testing / coverage ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Docker ---
*.pid

# --- Jupyter (in case of exploratory notebooks) ---
.ipynb_checkpoints/

# --- MLflow (if used locally) ---
mlruns/

# Allow model metadata JSON but not large binary model files
!models/*.json
models/*.joblib

# Allow pipeline report
!data/versions/pipeline_report.json
!data/versions/training_runs/
# --- 2026-10-02 review: never commit data exports, copies of a handoff, bundles or tests' replay output ---
out/
aryan files/
*.zip
*.patch
evidence_packet/replay_logs/
evidence_packet/backend_integration_bundle/model/
evidence_packet/backend_integration_bundle/history/
# models/release/ is FILLED by scripts/package_forecast_release.py (or by downloading a GitHub release's assets)
# and copied into the image; the files themselves live on the release, not in git (models/* above already ignores
# them).
